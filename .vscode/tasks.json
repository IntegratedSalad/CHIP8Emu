{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Emulator",
      "type": "shell",
      "command": "make",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Build Tests",
      "type": "shell",
      "command": "make test",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Run All Tests",
      "type": "shell",
      "command": "make run_tests",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Run Test (Prompt for YAML)",
      "type": "shell",
      "command": "make run_test FILE=${input:yamlFile}",
      "group": "test",
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "yamlFile",
      "type": "promptString",
      "description": "Path to YAML file to test",
      "default": "test/example.yaml"
    }
  ]
}