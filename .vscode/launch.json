{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Emulator",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/emulator",  // Path to your compiled binary
            "args": ["${workspaceFolder}/roms/chip8"], // Optional command-line arguments
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,                 // Use built-in VSCode terminal
            "MIMode": "lldb",                         // Use "gdb" if you prefer
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for LLDB",
                    "text": "settings set target.pretty-printing true",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "Debug Test",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/test_runner",
            "args": ["${input:testFile}"],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "MIMode": "lldb",
            "externalConsole": false,                 // Use built-in VSCode terminal
        }
    ],
     "inputs": [
        {
            "id": "testFile",
            "type": "promptString",
            "description": "Enter YAML test file path",
            "default": "${workspaceFolder}/test/logicalArithmeticInstructionsTest.yaml"
        }
    ]
}